#!/usr/bin/env bash
# Demo replay shim — prints REAL pre-captured ai-shell output with a short
# "thinking" pause, so the GIF is snappy (no 15s model wait). Content is genuine.
CAP="$(dirname "$0")/captures"
DIM='\033[2m'; CYAN='\033[1;36m'; GRN='\033[1;32m'; YEL='\033[1;33m'; RST='\033[0m'
think(){ printf "${DIM}🤔 Thinking (local qwen3:14b)...${RST}\n"; sleep 0.9; printf "\n"; }

# ai script "..."
if [ "$1" = "script" ]; then
  printf "${DIM}🛠  generating script...${RST}\n"; sleep 1.1; printf "\n"
  cat "$CAP/cmd3.txt"; printf "\n"
  printf "${GRN}✓ shellcheck: no warnings${RST}\n"
  printf "${RST} SAFETY LOCK: script contains destructive commands ${RST}\n" | sed "s/.*/$(printf '\033[1;41m') SAFETY LOCK: script contains destructive commands $(printf '\033[0m')/"
  printf "${YEL}  [dry-run/commented] line 22 (rm): rm -f \"\$file\"${RST}\n"
  printf "${DIM}Confirm to save? type y/yes: ${RST}\n"
  exit 0
fi

# strip flags to find the query
q=""; for a in "$@"; do case "$a" in --*) ;; *) q="$q $a";; esac; done

case "$q" in
  *largest*)
    think
    cat "$CAP/cmd1.txt"
    printf "${DIM}Enter to run / e to edit / any key cancels:${RST}\n"
    sleep 0.6
    printf "${DIM}\$ find . -type f -exec du -s {} + | sort -hr | head -n 3${RST}\n"
    cat "$CAP/cmd1_run.txt" ;;
  *"how do I use"*|*tar" command"*)
    think; cat "$CAP/cmd2.txt" ;;
  *explain*)
    printf "${DIM}🔍 breaking down command...${RST}\n"; sleep 0.9; printf "\n"
    cat "$CAP/cmd4.txt" ;;
  *inode*)
    think; cat "$CAP/cmd5.txt" ;;
  *install*)
    think; cat "$CAP/cmd6.txt"
    printf "${YEL}⚠  This command uses sudo and will modify the system.${RST}\n"
    printf "${DIM}Confirm? type y or yes (e to edit / any key cancels):${RST}\n" ;;
  *)
    think; printf "(demo)\n" ;;
esac
