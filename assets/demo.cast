[39.495, "o", "\u001b[2m🛠  generating script...\u001b[0m\r\n"]
[40.495, "o", "\r\n"]
[40.645, "o", "🛠  生成脚本中...\r\n\r\n\u001b[1;36m生成的脚本:\u001b[0m\r\n\u001b[2m──────────────────────────────────────────────────\u001b[0m\r\n#!/usr/bin/env bash\r\nset \u001b[1;36m-euo\u001b[0m pipefail\r\n\r\nFOLDER=\"/path/to/folder\"\r\n\r\nif [ \u001b[1;36m-z\u001b[0m \"$FOLDER\" ]; then\r\n    echo \"Folder path is not specified.\"\r\n    exit 1\r\nfi\r\n\r\nif [ ! \u001b[1;36m-d\u001b[0m \"$FOLDER\" ]; then\r\n    echo \"Folder $FOLDER does not exist.\"\r\n    exit 1\r\nfi\r\n\r\nif [ \"$FOLDER\" == \"/\" ]; then\r\n    echo \"Cannot delete files in root directory.\"\r\n    exit 1\r\nfi\r\n\r\n# Find and print cache files older than 7 days\r\nfind \"$FOLDER\" \u001b[1;36m-type\u001b[0m f \u001b[1;36m-name\u001b[0m \"*.cache\" \u001b[1;36m-mtime\u001b[0m +7 \u001b[1;36m-print\u001b[0m\r\n\r\n# Uncomment the line below to actually delete the files\r\n# find \"$FOLDER\" \u001b[1;36m-type\u001b[0m f \u001b[1;36m-name\u001b[0m \"*.cache\" \u001b[1;36m-mtime\u001b[0m +7 \u001b[1;36m-delete\u001b[0m\r\n\u001b[2m──────────────────────────────────────────────────\u001b[0m"]
[40.945, "o", "\r\n"]
[41.245, "o", "\r\n\u001b[1;32m✓ shellcheck: no warnings\u001b[0m\r\n"]
[41.445, "o", "\u001b[1;41m SAFETY LOCK: script contains destructive commands \u001b[0m\r\n"]
[41.645, "o", "\u001b[1;33m  [dry-run/commented] line 22 (rm): rm -f \"$file\"\u001b[0m\r\n"]
[44.245, "o", "\u001b[2mConfirm to save? type y/yes: \u001b[0m\r\n"]
