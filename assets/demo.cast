[5.53, "o", "find . \u001b[1;36m-type\u001b[0m f \u001b[1;36m-exec\u001b[0m du \u001b[1;36m-s\u001b[0m {} + | sort \u001b[1;36m-hr\u001b[0m | head \u001b[1;36m-n\u001b[0m 3\r\nDESC: Find all files in the current directory, calculate their sizes, sort them in human-readable format by size, and display the top 3 largest files."]
[6.13, "o", "\r\n"]
